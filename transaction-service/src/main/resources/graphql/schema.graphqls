type Query {
    transactions(accountId: ID): [Transaction!]!
    transaction(id: ID!): Transaction
}

type Mutation {
    createTransaction(input: TransactionInput!): Transaction!
    transfer(input: TransferInput!): TransferResult!
}

enum TransactionType {
    PAYMENT
    TRANSFER_OUT
    TRANSFER_IN
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
    type: TransactionType!
    transferId: ID
}

type TransferResult {
    transferId: ID!
    debit: Transaction!
    credit: Transaction!
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
    currency: String!
}